SUPABASE_SERVICE_KEY=

# SMTP config for welcome-email automation (netlify/functions/mailer.js)
# Use the same SMTP provider/credentials you configure in Supabase
# Project Settings -> Auth -> SMTP Settings, so both stay in sync.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Public site URL used to build the login link in the welcome email
SITE_URL=https://elevateme.pro

# Google Chat incoming webhook — used to alert on welcome-email send failures.
# Deliberately NOT another email address: if Gmail SMTP itself is down, an
# email-based alert would never arrive. Create via Google Chat space ->
# Apps & integrations -> Webhooks.
GOOGLE_CHAT_WEBHOOK_URL=
