SUPABASE_SERVICE_KEY=

# SMTP config for welcome-email automation (netlify/functions/mailer.js)
# Use the same SMTP provider/credentials you configure in Supabase
# Project Settings -> Auth -> SMTP Settings, so both stay in sync.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Public site URL used to build the login link in the welcome email
SITE_URL=https://elevateme.pro
